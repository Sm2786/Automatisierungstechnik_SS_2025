<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_AchsenRoboter" Id="{f6cb54f9-f7bc-4266-a06d-d060f431806e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AchsenRoboter
VAR_INPUT
	bEnable        	: BOOL;
    bExecute       	: BOOL;
    rPosition      	: REAL;
    bSensEndstop    : BOOL;
	bMoveing    	: BOOL;
END_VAR
VAR_OUTPUT
	eState			: eBetriebszustand;
END_VAR
VAR_IN_OUT
	ax				: Axis_Ref;
END_VAR
VAR
	mcPower     	: MC_Power;
    mcMoveAbs   	: MC_MoveAbsolute;
    mcHome      	: MC_Home;
	mcReset			: MC_Reset;
	
	bstoreExecute 	: BOOL;
    bHomeingDone     : BOOL;
    nState      	: INT := 0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ax.ReadStatus();

mcReset(
	Axis:= ax, 
	Execute:= , 
	Done=> , 
	Busy=> , 
	Error=> , 
	ErrorID=> );

mcPower(
	Axis:= ax, 
	Enable:= , 
	Enable_Positive:= , 
	Enable_Negative:= , 
	Override:= , 
	BufferMode:= , 
	Options:= , 
	Status=> , 
	Busy=> , 
	Error=> , 
	ErrorID=> );
	

CASE nState OF
	0: //Off
		eState := eBetriebszustand.Off;
		IF bEnable THEN
			nState := 1;
		END_IF
	
	1: //Init
		eState := eBetriebszustand.Init;
		mcPower(Enable := TRUE, Enable_Positive := TRUE,Enable_Negative := TRUE, Axis := ax);
        IF mcPower.Status THEN
            nState := 11;
        END_IF
	
	11: // Homeing
		eState := eBetriebszustand.Init;
		mcHome(
            Execute := TRUE,
            Axis := ax,
            HomingMode := MC_HomingMode.MC_DefaultHoming,
            bCalibrationCam := NOT bSensEndstop
        );
		
		IF mcHome.Done THEN
			mcHome.Execute := FALSE;
			bHomeingDone := TRUE;
			nState := 2;
		END_IF
	
	2: //Ready
		eState := eBetriebszustand.Ready;
		IF bExecute AND bHomeingDone AND NOT bstoreExecute THEN
			nState := 3;
		ELSIF bExecute AND NOT bHomeingDone THEN
			nState := 11;
		END_IF
		bstoreExecute := bExecute;
			
		
	3: //Achsen Bewegung
		eState := eBetriebszustand.Production;
		IF NOT bMoveing THEN
			mcMoveAbs.Execute := TRUE;
			mcMoveAbs(
				Axis := ax,
				Position := rPosition,
				Velocity := 30.0,
				Acceleration := 50.0,
				Deceleration := 50.0,
				Execute := mcMoveAbs.Execute
			);
			bMoveing := TRUE;
		ELSE
			mcMoveAbs.Execute := FALSE;
			mcMoveABs(Execute := FALSE, Axis := ax);
		END_IF
		
		IF mcMoveAbs.Done THEN
			bMoveing := FALSE;
			nState := 4;
			
		END_IF
	
	4: //Done
		eState := eBetriebszustand.Done;
		IF NOT bExecute THEN
			nState := 2;
		END_IF
		
	90: //Error
		eState := eBetriebszustand.Error;
		IF NOT bEnable AND NOT bExecute THEN
			nState := 11;
		END_IF
			
	
		
END_CASE]]></ST>
    </Implementation>
